{
  "name": "Trinergy QR Testing Tracker",
  "short_name": "Trinergy QR",
  "description": "Trinergy UPS QR based testing tracker for factory test-bay monitoring and stage updates.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#05111d",
  "theme_color": "#061827",
  "orientation": "any",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}